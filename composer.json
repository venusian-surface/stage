{
    "name": "venusian-surface/stage",
    "description": "Surface stages: engine-owned windows opened on a stage.<host> host and drawn by a gpu.<engine> engine.",
    "license": "MIT",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "venusian-surface/contracts": "^0.8.0",
        "venusian-surface/drawing": "^0.8.0",
        "venusian-voyager/contracts": "^0.8.0",
        "venusian-voyager/io-pools": "^0.8.0",
        "venusian-voyager/magic-aliases": "^0.8.0",
        "venusian-voyager/nuts-and-bolts": "^0.8.0"
    },
    "suggest": {
        "jovian/venusian-appkit": "^0.8.0 - To build apps that use MacOS Windows using AppKit",
        "jovian/venusian-sdl3": "^0.8.0 - The sdl3 stage host (engine-owned SDL windows) and the sdl3 GPU engine (SDL_GPU)."
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Surface\\Stage\\": ""
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.8.x-dev"
        },
        "venusian": {
            "providers": [
                "Surface\\Stage\\StageServiceProvider"
            ],
            "aliases": {
                "Stage": "Surface\\Stage\\MagicAliases\\Stage"
            }
        }
    }
}
